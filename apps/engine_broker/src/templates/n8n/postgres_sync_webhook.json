{
  "id": "postgres_sync_webhook",
  "name": "Postgres Query Pipeline & Redis Stream",
  "description": "Executes parameterized SQL queries against Postgres and publishes resulting record changes to Redis channels.",
  "category": "Data & Streaming",
  "trigger_type": "Webhook",
  "nodes_count": 3,
  "tags": ["Postgres", "Redis", "PubSub", "Pipeline"],
  "workflow": {
    "name": "Postgres Query Pipeline & Redis Stream",
    "nodes": [
      {
        "parameters": {
          "httpMethod": "POST",
          "path": "postgres-query-stream",
          "responseMode": "onReceived"
        },
        "id": "node_webhook",
        "name": "Query Ingestion",
        "type": "n8n-nodes-base.webhook",
        "typeVersion": 2,
        "position": [240, 300],
        "webhookId": "postgres-query-stream-trigger"
      },
      {
        "parameters": {
          "method": "POST",
          "url": "http://engine-broker:8000/api/v1/mcp/tools/postgres_query_runner/invoke",
          "sendBody": true,
          "specifyBody": "json",
          "jsonBody": "={\n  \"query\": $json.query || \"SELECT * FROM executions ORDER BY created_at DESC LIMIT 5\",\n  \"params\": []\n}"
        },
        "id": "node_exec_sql",
        "name": "Run SQL Query",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [480, 300]
      },
      {
        "parameters": {
          "method": "POST",
          "url": "http://engine-broker:8000/api/v1/mcp/tools/redis_pubsub_bus/invoke",
          "sendBody": true,
          "specifyBody": "json",
          "jsonBody": "={\n  \"channel\": \"db-updates\",\n  \"message\": JSON.stringify($json)\n}"
        },
        "id": "node_redis_pub",
        "name": "Publish to Redis",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [720, 300]
      }
    ],
    "connections": {
      "Query Ingestion": {
        "main": [
          [
            {
              "node": "Run SQL Query",
              "type": "main",
              "index": 0
            }
          ]
        ]
      },
      "Run SQL Query": {
        "main": [
          [
            {
              "node": "Publish to Redis",
              "type": "main",
              "index": 0
            }
          ]
        ]
      }
    },
    "settings": {
      "executionOrder": "v1"
    }
  }
}
