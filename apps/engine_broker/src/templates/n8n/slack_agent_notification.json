{
  "id": "slack_agent_notification",
  "name": "Multi-Agent Slack Broadcast & Escalation",
  "description": "Broadcasts agent swarm run milestones, approvals, and anomalies into Slack channels.",
  "category": "Communication",
  "trigger_type": "Webhook",
  "nodes_count": 3,
  "tags": ["Slack", "Alerts", "Monitoring", "Swarms"],
  "workflow": {
    "name": "Multi-Agent Slack Broadcast & Escalation",
    "nodes": [
      {
        "parameters": {
          "httpMethod": "POST",
          "path": "slack-agent-alert",
          "responseMode": "onReceived"
        },
        "id": "node_webhook",
        "name": "Alert Webhook",
        "type": "n8n-nodes-base.webhook",
        "typeVersion": 2,
        "position": [240, 300],
        "webhookId": "slack-agent-alert-trigger"
      },
      {
        "parameters": {
          "jsCode": "const data = $input.first().json;\nconst emoji = data.status === 'completed' ? '✅' : (data.status === 'failed' ? '🚨' : '⚡');\nconst text = `${emoji} *OmniSwarm Milestone: ${data.name || 'Swarm'}*\\n• Engine: [${(data.engine || 'LangGraph').toUpperCase()}]\\n• Status: *${(data.status || 'RUNNING').toUpperCase()}*\\n• Message: ${data.message || 'Workflow progressing normally.'}`;\n\nreturn [{ json: { text, channel: data.channel || '#agent-swarms' } }];"
        },
        "id": "node_formatter",
        "name": "Format Slack Blocks",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [480, 300]
      },
      {
        "parameters": {
          "method": "POST",
          "url": "http://engine-broker:8000/api/v1/mcp/tools/slack_notifier_bot/invoke",
          "sendBody": true,
          "specifyBody": "json",
          "jsonBody": "={\n  \"channel\": $json.channel,\n  \"message\": $json.text\n}"
        },
        "id": "node_mcp_slack",
        "name": "Invoke Slack Tool",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [720, 300]
      }
    ],
    "connections": {
      "Alert Webhook": {
        "main": [
          [
            {
              "node": "Format Slack Blocks",
              "type": "main",
              "index": 0
            }
          ]
        ]
      },
      "Format Slack Blocks": {
        "main": [
          [
            {
              "node": "Invoke Slack Tool",
              "type": "main",
              "index": 0
            }
          ]
        ]
      }
    },
    "settings": {
      "executionOrder": "v1"
    }
  }
}
