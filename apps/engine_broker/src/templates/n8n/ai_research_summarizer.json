{
  "id": "ai_research_summarizer",
  "name": "Autonomous Web Research & Summarizer",
  "description": "Scrapes a URL using the Browser MCP tool, extracts core content, and uses the OpenAI tool to synthesize an intelligence report.",
  "category": "AI & Research",
  "trigger_type": "Webhook",
  "nodes_count": 3,
  "tags": ["Browser", "OpenAI", "Research", "Synthesis"],
  "workflow": {
    "name": "Autonomous Web Research & Summarizer",
    "nodes": [
      {
        "parameters": {
          "httpMethod": "POST",
          "path": "web-research",
          "responseMode": "onReceived"
        },
        "id": "node_webhook",
        "name": "Research Trigger",
        "type": "n8n-nodes-base.webhook",
        "typeVersion": 2,
        "position": [240, 300],
        "webhookId": "web-research-trigger"
      },
      {
        "parameters": {
          "method": "POST",
          "url": "http://engine-broker:8000/api/v1/mcp/tools/browser_web_navigator/invoke",
          "sendBody": true,
          "specifyBody": "json",
          "jsonBody": "={\n  \"url\": $json.url || \"https://news.ycombinator.com\",\n  \"action\": \"scrape_article\"\n}"
        },
        "id": "node_mcp_browser",
        "name": "Scrape Web Content",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [480, 300]
      },
      {
        "parameters": {
          "method": "POST",
          "url": "http://engine-broker:8000/api/v1/mcp/tools/openai_model_router/invoke",
          "sendBody": true,
          "specifyBody": "json",
          "jsonBody": "={\n  \"prompt\": \"Summarize the following web content into 3 key takeaways: \" + JSON.stringify($json.result),\n  \"model\": \"gpt-4o\"\n}"
        },
        "id": "node_mcp_openai",
        "name": "Generate Summary",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [720, 300]
      }
    ],
    "connections": {
      "Research Trigger": {
        "main": [
          [
            {
              "node": "Scrape Web Content",
              "type": "main",
              "index": 0
            }
          ]
        ]
      },
      "Scrape Web Content": {
        "main": [
          [
            {
              "node": "Generate Summary",
              "type": "main",
              "index": 0
            }
          ]
        ]
      }
    },
    "settings": {
      "executionOrder": "v1"
    }
  }
}
