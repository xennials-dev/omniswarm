# OmniSwarm Core Environment Configuration

# Server
PORT=8000
HOST=0.0.0.0
DEBUG=true
ENVIRONMENT=development

# Database & Cache
DATABASE_URL=postgresql://omniswarm:omniswarm_secret@postgres:5432/omniswarm_db
REDIS_URL=redis://redis:6379/0

# Authentication (Ory Kratos / JWT)
JWT_SECRET_KEY=omniswarm-super-secret-dev-key-change-in-production
AUTH_ENABLED=false

# LLM Providers & Consoles
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LITELLM_ENDPOINT=http://litellm:4000
OPEN_WEBUI_ENDPOINT=http://open-webui:8080

# Sidecar Endpoints
LANGGRAPH_SIDECAR_URL=http://sidecar-langgraph:8100
CREWAI_SIDECAR_URL=http://sidecar-crewai:8200
N8N_SIDECAR_URL=http://n8n:5678
N8N_API_KEY=

# Sandboxes
E2B_API_KEY=
DAYTONA_API_KEY=
